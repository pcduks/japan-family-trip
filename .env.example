# Browser key: Maps JavaScript API only, restricted by HTTP referrer to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID with a muted cloud style (light). Optional second ID for dark mode;
# without it the light Map ID is rendered with colorScheme=DARK.
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAP_ID_DARK=

# Server key: Places API (New) + Routes API, restricted by API. Never exposed to the browser.
GOOGLE_PLACES_API_KEY=
# Server key with YouTube Data API v3 (can be the same key as above).
YOUTUBE_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: seconds to keep Place Details in the server data cache (default 3600).
# Check Google's current caching terms before raising it.
# PLACES_CACHE_SECONDS=3600
# Optional: allow demo mode (no Supabase, no sign-in) in a production build. Never on a public URL.
# DEMO_MODE=1
