# Copy to .env.local (git-ignored). Names starting NEXT_PUBLIC_ reach the browser.
# If Vercel refuses a NEXT_PUBLIC_ name, use the same name without the prefix
# (e.g. SUPABASE_URL); next.config.ts accepts both.

# Google Maps Platform (Appendix B). Browser key: Maps JavaScript API only,
# restricted by HTTP referrer to localhost:3000 and your Vercel domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID with a light style; optional second ID for dark mode (otherwise the
# light Map ID is rendered with colorScheme=DARK).
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAP_ID_DARK=
# Server key: Places API (New) + Routes API, restricted by API. Never sent to the browser.
GOOGLE_PLACES_API_KEY=
# Server key with YouTube Data API v3 (can be the same key as above).
YOUTUBE_API_KEY=

# Anthropic: drop extraction (PRD §6) and the spike. Set a monthly spend limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Supabase: Project → Settings → API. The anon key is public by design (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Beta access: the one code the family types once (then they tap their name).
# Defaults to fuji2026 when unset; change it here to sign everyone out.
FAMILY_CODE=fuji2026

# A long random string. Sent as "Authorization: Bearer …" by Claude sessions to
# POST /api/import and /api/connector/* (places, notes, drops; never the plan).
CLAUDE_CONNECTOR_TOKEN=

# Optional, for `npm run db:push` (applies supabase/migrations through the Management API).
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# Optional: seconds to keep Place Details in the server cache (default 3600).
# PLACES_CACHE_SECONDS=3600
# Optional: allow demo mode (no Supabase, no sign-in) in a production build. Never on a public URL.
# DEMO_MODE=1
